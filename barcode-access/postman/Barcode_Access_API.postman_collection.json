		{
			"name": "Bulk Operations",
			"item": [
				{
					"name": "Create Multiple Tickets",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// This is a helper to generate multiple tickets",
									"// Run this in a loop using Collection Runner or Newman",
									"const uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
									"    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);",
									"    return v.toString(16);",
									"});",
									"pm.variables.set('bulk_uuid', uuid);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"uuid\": \"{{bulk_uuid}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/tickets",
							"host": ["{{base_url}}"],
							"path": ["api", "tickets"]
						},
						"description": "Usar con Collection Runner para crear múltiples tickets. Configurar iterations=N para crear N tickets."
					},
					"response": []
				}
			]
