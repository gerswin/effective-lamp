# Configuración del Cliente
# -------------------------------------------------------------------

# ID de la Puerta (1-4)
# Poner 0 para auto-configuración (requiere servidor v2)
door.id=0

# Dispositivo de entrada (Lector de código de barras)
# Usar 'ls -la /dev/input/by-id/' para encontrar el ID correcto
input.device=/dev/input/by-id/usb-BarCode_Scanner_v1.0.0-event-kbd

# URL del Servidor Central
# Usar "auto" para buscar el servidor automáticamente en la red local
server.url=auto

# Configuración de Controladora Hikvision DS-K2604T
# Estas credenciales se sobreescribirán si se usa auto-provisioning
hikvision.host=192.168.1.100
hikvision.port=80
hikvision.username=admin
hikvision.password=admin12345
