# Usamos Debian Bookworm (arm64/amd64) para cross-compilar
FROM debian:bookworm

# Evitar preguntas interactivas durante la instalación
ENV DEBIAN_FRONTEND=noninteractive

# 1. Instalar dependencias de construcción y cross-compiler para armel
# armel es la arquitectura más segura para Pi Zero (Soft Float)
RUN dpkg --add-architecture armel && apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    pkg-config \
    gcc-arm-linux-gnueabi \
    g++-arm-linux-gnueabi \
    libpq-dev:armel \
    libcurl4-openssl-dev:armel \
    libevdev-dev:armel \
    libatomic1:armel \
    patchelf \
    && rm -rf /var/lib/apt/lists/*

# Configuración de CMake para cross-compilation
ENV CMAKE_C_COMPILER=arm-linux-gnueabi-gcc
ENV CMAKE_CXX_COMPILER=arm-linux-gnueabi-g++
ENV PKG_CONFIG_PATH=/usr/lib/arm-linux-gnueabi/pkgconfig
ENV PKG_CONFIG_LIBDIR=/usr/lib/arm-linux-gnueabi/pkgconfig
ENV PKG_CONFIG_SYSROOT_DIR=/

# 2. Instalar Oat++ (v1.3.0) - Cross-compiling
WORKDIR /tmp
RUN git clone --depth 1 --branch 1.3.0 https://github.com/oatpp/oatpp.git \
    && cd oatpp \
    && mkdir build && cd build \
    && cmake \
        -DCMAKE_C_COMPILER=arm-linux-gnueabi-gcc \
        -DCMAKE_CXX_COMPILER=arm-linux-gnueabi-g++ \
        -DCMAKE_SYSTEM_NAME=Linux \
        -DCMAKE_SYSTEM_PROCESSOR=arm \
        -DOATPP_DISABLE_ENV_OBJECT_COUNTERS=ON \
        -DCMAKE_BUILD_TYPE=Release \
        -DOATPP_BUILD_TESTS=OFF \
        .. \
    && make -j$(nproc) install \
    && cd ../.. && rm -rf oatpp

# 3. Instalar Oatpp-PostgreSQL (v1.3.0) - Cross-compiling
RUN git clone --depth 1 --branch 1.3.0 https://github.com/oatpp/oatpp-postgresql.git \
    && cd oatpp-postgresql \
    && mkdir build && cd build \
    && cmake \
        -DCMAKE_C_COMPILER=arm-linux-gnueabi-gcc \
        -DCMAKE_CXX_COMPILER=arm-linux-gnueabi-g++ \
        -DCMAKE_SYSTEM_NAME=Linux \
        -DCMAKE_SYSTEM_PROCESSOR=arm \
        -DOATPP_DISABLE_ENV_OBJECT_COUNTERS=ON \
        -DCMAKE_BUILD_TYPE=Release \
        -DOATPP_BUILD_TESTS=OFF \
        .. \
    && make -j$(nproc) install \
    && cd ../.. && rm -rf oatpp-postgresql

# 4. Copiar el código fuente del proyecto
WORKDIR /app
COPY . .

# 5. Compilar el proyecto
RUN rm -rf build && mkdir build && cd build \
    && cmake \
        -DCMAKE_C_COMPILER=arm-linux-gnueabi-gcc \
        -DCMAKE_CXX_COMPILER=arm-linux-gnueabi-g++ \
        -DCMAKE_SYSTEM_NAME=Linux \
        -DCMAKE_SYSTEM_PROCESSOR=arm \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        .. \
    && make -j$(nproc)

# 6. Recolectar librerías dependientes (Bundling)
WORKDIR /app/dist
RUN mkdir -p libs

# Copiamos los binarios
RUN cp /app/build/server/access-server .
RUN cp /app/build/client/access-client .
RUN cp /app/config.ini.example ./config.ini
RUN cp /app/client.ini.example ./client.ini

# Copiamos las librerías encontrándolas dinámicamente para evitar errores de ruta
RUN find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libpq.so.5" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libcurl.so.4" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libstdc++.so.6" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libgcc_s.so.1" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libatomic.so.1" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libevdev.so.2" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libc.so.6" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libm.so.6" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libpthread.so.0" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libdl.so.2" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "librt.so.1" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libssl.so.3" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libcrypto.so.3" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libz.so.1" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libnghttp2.so.14" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libidn2.so.0" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libpsl.so.5" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libssh2.so.1" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libgssapi_krb5.so.2" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libldap-2.5.so.0" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "liblber-2.5.so.0" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libzstd.so.1" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libbrotlidec.so.1" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libbrotlicommon.so.1" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libkrb5.so.3" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libk5crypto.so.3" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libcom_err.so.2" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libkrb5support.so.0" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libkeyutils.so.1" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libresolv.so.2" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libgnutls.so.30" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libp11-kit.so.0" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libtasn1.so.6" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libnettle.so.8" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libhogweed.so.6" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libgmp.so.10" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libunistring.so.2" -exec cp -v {} libs/ \; \
    && find /usr/lib/arm-linux-gnueabi /lib/arm-linux-gnueabi -name "libsasl2.so.2" -exec cp -v {} libs/ \;

# Copiamos el cargador dinámico también por si acaso se quiere usar explícitamente
RUN cp /lib/ld-linux.so.3 libs/

# Crear script de arranque portable
RUN echo '#!/bin/bash' > run_client.sh \
    && echo 'export LD_LIBRARY_PATH=$PWD/libs:$LD_LIBRARY_PATH' >> run_client.sh \
    && echo 'exec ./access-client "$@"' >> run_client.sh \
    && chmod +x run_client.sh

RUN echo '#!/bin/bash' > run_server.sh \
    && echo 'export LD_LIBRARY_PATH=$PWD/libs:$LD_LIBRARY_PATH' >> run_server.sh \
    && echo 'exec ./access-server "$@"' >> run_server.sh \
    && chmod +x run_server.sh
